<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elyjah._026_10_01bookdemo.mapper.BookInfoMapper">

    <sql id="allColumn">
        id, book_name, author, `count`, price, publish, `status`, create_time, update_time
    </sql>

    <sql id="bookCondition">
        <where>
            status != 0
            <if test='bookName != null and bookName != ""'>
                and book_name like concat('%', #{bookName}, '%')
            </if>
        </where>
    </sql>

    <!-- ========== 查询总数 ========== -->
    <select id="count" resultType="java.lang.Integer">
        select count(1)
        from book_info
        <include refid="bookCondition"/>
    </select>

    <!-- ========== 分页查询 ========== -->
    <select id="queryBookListByPage" resultType="com.elyjah._026_10_01bookdemo.model.BookInfo">
        select
        <include refid="allColumn"/>
        from book_info
        <include refid="bookCondition"/>
        order by id desc
        limit #{pageRequest.offset}, #{pageRequest.pageSize}
    </select>

    <!--查询单个    -->
    <select id="queryBookById" resultType="com.elyjah._026_10_01bookdemo.model.BookInfo">
        select
        <include refid="allColumn"/>
        from book_info
        where id = #{bookId}  and status != 0
        <!--            &lt;（小于）、&gt;（大于）、&amp;（与号）。-->
    </select>


<!--更新-->
    <update id="updateBook">
        update book_info
        <set>
            <if test='bookName != null'>
                book_name = #{bookName},
            </if>
            <if test='author != null'>
                author = #{author},
            </if>
            <if test='price != null'>
                price = #{price},
            </if>
            <if test='count != null'>
                `count` = #{count},
            </if>
            <if test='publish != null'>
                publish = #{publish},
            </if>
            <if test='status != null'>
                `status` = #{status},
            </if>
        </set>
        where id = #{id}
    </update>

<!--    MyBatis 先把 <set> 内部的 <if> 全部求值，把成立的内容拼成一个字符串-->
<!--    如果字符串非空：去掉结尾的逗号，加上前缀 set-->
<!--    如果字符串为空：整个 <set> 块消失，一个字符都不输出-->





    <!--批量删除-->
    <update id="batchDeleteBook">
        update book_info
        set status = 0
        where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </update>



</mapper>
